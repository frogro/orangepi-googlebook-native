+/* Read-only snapshots. No reset, register write or recovery behavior changes. */
+static void hdmirx_audio_diag(struct snps_hdmirx_dev *d, const char *event,
+                              u32 fs)
+{
+ if (!audio_diag)
+  return;
+ dev_info(d->dev,
+  "AUDDIAG %s fs=%u configured=%u link=%d stream=%d worker=%d clk=%lu enable=%08x proc=%08x fifo=%08x tmds=%08x\n",
+  event, fs, d->audio_fs, d->audio_link_ready, d->audio_streaming,
+  d->audio_running, clk_get_rate(d->clks[1].clk),
+  hdmirx_readl(d, GLOBAL_SWENABLE), hdmirx_readl(d, AUDIO_PROC_CONFIG0),
+  hdmirx_readl(d, AUDIO_FIFO_STATUS2), hdmirx_readl(d, CMU_TMDSQPCLK_FREQ));
+}
