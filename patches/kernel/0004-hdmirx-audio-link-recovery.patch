+/* Control paths hold audio_lock. The worker never takes it, so draining
+ * cannot deadlock; disarm before cancel to prevent self-rescheduling. */
+static void hdmirx_audio_stop(struct snps_hdmirx_dev *hdmirx_dev)
+{
+	WRITE_ONCE(hdmirx_dev->audio_running, false);
+	cancel_delayed_work_sync(&hdmirx_dev->audio_work);
+}
