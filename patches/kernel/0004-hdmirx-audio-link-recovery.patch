+	hdmirx_audio_stop(hdmirx_dev);
 	hdmirx_update_bits(hdmirx_dev, GLOBAL_SWENABLE, AUDIO_ENABLE, 0);
+	mutex_unlock(&hdmirx_dev->audio_lock);
 }
 
