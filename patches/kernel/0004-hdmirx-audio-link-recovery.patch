+static void hdmirx_audio_link(struct snps_hdmirx_dev *hdmirx_dev, bool ready)
+{
+	mutex_lock(&hdmirx_dev->audio_lock);
+	hdmirx_audio_stop(hdmirx_dev);
+	hdmirx_dev->audio_link_ready = ready;
+	if (hdmirx_dev->audio_removing)
+		goto out;
+	hdmirx_update_bits(hdmirx_dev, GLOBAL_SWENABLE, AUDIO_ENABLE, 0);
+	if (ready && hdmirx_dev->audio_streaming &&
+	    !hdmirx_audio_setup(hdmirx_dev, hdmirx_dev->audio_fs)) {
+		WRITE_ONCE(hdmirx_dev->audio_running, true);
+		queue_delayed_work(system_unbound_wq, &hdmirx_dev->audio_work,
+				   msecs_to_jiffies(200));
+	}
+	dev_dbg(hdmirx_dev->dev, "audio link ready=%d streaming=%d running=%d\n",
+		ready, hdmirx_dev->audio_streaming, hdmirx_dev->audio_running);
+out:
+	mutex_unlock(&hdmirx_dev->audio_lock);
+}
+
+static int hdmirx_audio_hw_params(struct device *dev, void *data,
+				struct hdmi_codec_daifmt *fmt,
+				struct hdmi_codec_params *hparms)
+{
+	struct snps_hdmirx_dev *hdmirx_dev = dev_get_drvdata(dev);
+	u32 fs;
+	int ret = 0;
+
+	mutex_lock(&hdmirx_dev->audio_lock);
+	if (hdmirx_dev->audio_removing) {
+		ret = -ENODEV;
+		goto out;
+	}
+	hdmirx_audio_stop(hdmirx_dev);
+	fs = hdmirx_audio_fs(hdmirx_dev);
+	if (!fs)
+		fs = hparms ? hparms->sample_rate : 48000;
+	if (!fs)
+		fs = 48000;
+	hdmirx_dev->audio_fs = fs;
+	hdmirx_dev->audio_streaming = true;
+	if (hdmirx_dev->audio_link_ready) {
+		ret = hdmirx_audio_setup(hdmirx_dev, fs);
+		if (ret) {
+			hdmirx_dev->audio_streaming = false;
+			goto out;
+		}
+		WRITE_ONCE(hdmirx_dev->audio_running, true);
+		queue_delayed_work(system_unbound_wq, &hdmirx_dev->audio_work,
+				   msecs_to_jiffies(200));
+	}
+	dev_dbg(dev, "audio hw_params: fs=%u ready=%d\n", fs,
+		hdmirx_dev->audio_link_ready);
+out:
+	mutex_unlock(&hdmirx_dev->audio_lock);
+	return ret;
+}
