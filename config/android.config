CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
CONFIG_MEMFD_CREATE=y
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Android debug USB: configfs + FunctionFS, no competing legacy gadget.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_AUDIO=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_ETH=n
# Honour the userdebug cmdline; enforcing remains the normal default.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# First-stage init must be able to mount system/vendor before loading modules.
CONFIG_EXT4_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
# Preserve early display/input and simplify first boot diagnostics.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_PANTHOR=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
CONFIG_R8169=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
