# Native RK3588 host hardware, including Android Linux terminal guest support.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# First-stage Android init needs loop-control before module loading.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
# Stock Googlebook system AVB descriptor contains FEC roots=2.
CONFIG_DM_VERITY_FEC=y

# Stock Googlebook /system/etc/cgroups.json mounts blkio and cpuset v1.
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG=y

# Googlebook ext4 userdata checkpoint=block; needed before /data mounts.
CONFIG_DM_BOW=y

# Fresh Googlebook ext4 userdata is formatted with casefold enabled.
# Built-in support is required before first-stage /data mounting.
CONFIG_UNICODE=y

# Generic userspace parity with the original Googlebook 6.12.81 kernel.
# SWAP is required even when ZRAM itself already builds successfully.
CONFIG_SWAP=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_MEMCG_V1=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_IO_URING=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_NETFILTER_XT_TARGET_NOTRACK=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
# Keep the original Bluetooth profiles modular. HAL integration is separate.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=m

# Android Virtualization Framework: unprotected Linux terminal VM.
# Built-in transport avoids dependency on Android module autoloading.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VHOST=y
CONFIG_VHOST_IOTLB=y
CONFIG_VHOST_VSOCK=y
CONFIG_TUN=y
CONFIG_EVENTFD=y
CONFIG_UNIX=y

# Android legacy shared-memory ioctl compatibility on memfd.
CONFIG_MEMFD_CREATE=y
CONFIG_MEMFD_ASHMEM_SHIM=y
